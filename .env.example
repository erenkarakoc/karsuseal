# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_...

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Browser push notifications (npm run vapid) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@karsuseal.com

# --- E-mail notifications (Resend free tier: 3.000 mails / month) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. bildirim@karsuseal.com
NOTIFY_FROM_EMAIL="Karsu Seal <bildirim@karsuseal.com>"

# --- Spam koruması (isteğe bağlı): Cloudflare Turnstile, ücretsiz ---
# Cloudflare panel → Turnstile → Add widget (alan adı: karsuseal.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
